{{ 'waterboy.css' | asset_url | stylesheet_tag }}

<div class="waterboy">
  <section class="benefits" id="{{ section.settings.anchor | default: 'benefits' }}">
    <div class="wrap">
      <div class="section-head">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <p>{{ section.settings.body }}</p>
        {% endif %}
      </div>
      <div class="benefit-grid">
        {%- for block in section.blocks -%}
          <div class="benefit" {{ block.shopify_attributes }}>
            <div class="benefit-icon">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                {%- when 'clock' -%}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                {%- when 'bolt' -%}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                {%- when 'check' -%}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7L9 18l-5-5"/></svg>
                {%- else -%}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
              {%- endcase -%}
            </div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Waterboy Benefits",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "benefits" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's Inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built For Mornings You'd Rather Forget." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Four actives working together to flush dehydration, settle the stomach, and get your head back in the game — without the sugar crash." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "clock", "label": "Clock" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "check", "label": "Check" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Benefit description." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Waterboy Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "shield", "title": "1200mg Electrolytes", "body": "Sodium, potassium, magnesium, calcium, chloride, and phosphorus — 2x what you'll find in a Liquid I.V. stick." } },
        { "type": "benefit", "settings": { "icon": "clock", "title": "L-Theanine 200mg", "body": "Takes the edge off brain fog and anxious shakes without the sedating pull of melatonin." } },
        { "type": "benefit", "settings": { "icon": "bolt", "title": "Full B-Complex", "body": "B1, B3, B5, B6, B12 and folate — the vitamins alcohol strips first and your body needs to produce energy." } },
        { "type": "benefit", "settings": { "icon": "check", "title": "Zero Added Sugar", "body": "Sweetened with stevia and monk fruit. Three real-fruit flavors, no artificial colors, nothing to crash from." } }
      ]
    }
  ]
}
{% endschema %}
