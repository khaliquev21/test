{{ 'waterboy.css' | asset_url | stylesheet_tag }}

<div class="waterboy">
  <section class="final-cta">
    <div class="wrap">
      <h2>
        {{ section.settings.heading_before }}
        {% if section.settings.heading_accent != blank %}
          <span class="accent">{{ section.settings.heading_accent }}</span>
        {% endif %}
      </h2>
      {% if section.settings.body != blank %}
        <p>{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#shop' }}" class="btn btn-primary">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Waterboy Final CTA",
  "settings": [
    { "type": "text", "id": "heading_before", "label": "Heading (before accent)", "default": "Stop Dreading" },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent)", "default": "Tomorrow Morning." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "One box in the pantry replaces half the stuff on your bathroom shelf. 60-day guarantee if it doesn't deliver." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Grab A Pack →" },
    { "type": "url", "id": "cta_url", "label": "Button URL" }
  ],
  "presets": [ { "name": "Waterboy Final CTA" } ]
}
{% endschema %}
