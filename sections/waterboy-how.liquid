{{ 'waterboy.css' | asset_url | stylesheet_tag }}

<div class="waterboy">
  <section class="how" id="{{ section.settings.anchor | default: 'how' }}">
    <div class="wrap">
      <div class="section-head">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
      <div class="how-grid">
        {%- for block in section.blocks -%}
          <div class="step" {{ block.shopify_attributes }}>
            <div class="step-num">{{ forloop.index }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Waterboy How It Works",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "how" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dead Simple" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mix. Drink. Recover." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Step body." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Waterboy How It Works",
      "blocks": [
        { "type": "step", "settings": { "title": "Tear & Pour", "body": "Empty one stick pack into 12-16 oz of cold water." } },
        { "type": "step", "settings": { "title": "Stir & Shake", "body": "Mixes clean in seconds — no gritty bottom-of-the-glass finish." } },
        { "type": "step", "settings": { "title": "Feel It Hit", "body": "Most customers feel noticeably clearer within 15–20 minutes." } }
      ]
    }
  ]
}
{% endschema %}
