{{ 'waterboy.css' | asset_url | stylesheet_tag }}
<script src="{{ 'waterboy.js' | asset_url }}" defer></script>

{%- liquid
  assign product = all_products[section.settings.product]
  assign has_product = false
  if product != blank and product.id
    assign has_product = true
  endif

  assign flavor_option_name = section.settings.flavor_option_name | default: 'Flavor'
  assign size_option_name = section.settings.size_option_name | default: 'Size'

  assign flavor_index = -1
  assign size_index = -1
  if has_product
    for opt in product.options_with_values
      assign idx = forloop.index0
      assign opt_name = opt.name | downcase
      assign flavor_target = flavor_option_name | downcase
      assign size_target = size_option_name | downcase
      if opt_name == flavor_target
        assign flavor_index = idx
      endif
      if opt_name == size_target
        assign size_index = idx
      endif
    endfor
  endif
-%}

<div class="waterboy">
  <section class="product-page"
           id="{{ section.settings.anchor | default: 'shop' }}"
           data-waterboy-product
           data-money-format="{{ shop.money_format | escape }}"
           data-can-sub-prefix="{{ section.settings.can_sub_prefix | default: 'Recovery Mix' | escape }}"
           data-default-flavor="{{ section.settings.default_flavor | default: 'Berry' | escape }}">
    <div class="wrap">
      <div class="pp-grid">

        <!-- GALLERY -->
        <div class="pp-gallery">
          <div class="pp-main" id="ppMain" data-flavor="{{ section.settings.default_flavor | default: 'Berry' }}">
            {%- if has_product and product.featured_image -%}
              <img class="product-image"
                   src="{{ product.featured_image | image_url: width: 900 }}"
                   alt="{{ product.featured_image.alt | default: product.title | escape }}"
                   width="900" height="900" loading="lazy">
            {%- else -%}
              <div class="can">
                <div class="can-badge">{{ section.settings.badge_text | default: 'NEW' }}<span class="n">{{ section.settings.badge_count | default: '30ct' }}</span></div>
                <div class="can-label">
                  {{ section.settings.can_label_top | default: 'Water' }}<span class="accent">{{ section.settings.can_label_bottom | default: 'Boy' }}</span>
                </div>
                <div class="can-sub" id="canSub">{{ section.settings.can_sub_prefix | default: 'Recovery Mix' }} · {{ section.settings.default_flavor | default: 'Berry' }}</div>
                <div class="can-base">{{ section.settings.can_base | default: 'Electrolytes · L-Theanine · B-Complex' }}</div>
              </div>
            {%- endif -%}
          </div>

          <div class="pp-thumbs">
            {%- for block in section.blocks -%}
              {%- if block.type == 'flavor' -%}
                <button type="button" class="pp-thumb{% if forloop.first %} active{% endif %}" data-flavor="{{ block.settings.name }}" aria-label="{{ block.settings.name }}">
                  <span class="mini-can"></span>
                </button>
              {%- endif -%}
            {%- endfor -%}
            <button type="button" class="pp-thumb" aria-label="Nutrition facts" style="background: var(--cream-shade)">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--ink-soft)"><rect x="4" y="3" width="16" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>
            </button>
          </div>
        </div>

        <!-- DETAILS -->
        <div class="pp-details">
          <div class="pp-breadcrumb">{{ section.settings.breadcrumb | default: 'Home / Shop / Recovery Mix' }}</div>
          <h1 class="pp-title">
            {%- if has_product -%}{{ product.title }}{%- else -%}{{ section.settings.title | default: 'Waterboy Recovery Mix' }}{%- endif -%}
          </h1>
          <div class="pp-rating-row">
            <span class="stars">{{ section.settings.stars | default: '★★★★★' }}</span>
            <strong style="color: var(--ink)">{{ section.settings.rating | default: '4.9' }}</strong>
            <a href="#{{ section.settings.reviews_anchor | default: 'reviews' }}">{{ section.settings.rating_count | default: '12,847 verified reviews' }}</a>
          </div>
          <p class="pp-tagline">
            {%- if has_product and product.description != blank and section.settings.use_product_description -%}
              {{ product.description | strip_html | truncatewords: 50 }}
            {%- else -%}
              {{ section.settings.tagline | default: "The all-in-one recovery stick for mornings you'd rather forget. 1200mg electrolytes, 200mg L-Theanine, and a full B-complex — in one glass of water." }}
            {%- endif -%}
          </p>

          <div class="pp-price-row">
            <span class="pp-price" id="currentPrice">
              {%- if has_product -%}{{ product.selected_or_first_available_variant.price | money }}{%- else -%}${{ section.settings.fallback_price | default: '59' }}{%- endif -%}
            </span>
            <span class="pp-price-was" id="currentWas"
              {%- if has_product and product.selected_or_first_available_variant.compare_at_price <= product.selected_or_first_available_variant.price %} style="display:none"{%- endif -%}>
              {%- if has_product -%}
                {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                  {{ product.selected_or_first_available_variant.compare_at_price | money }}
                {%- endif -%}
              {%- else -%}${{ section.settings.fallback_was | default: '84' }}{%- endif -%}
            </span>
            {% if section.settings.save_badge != blank %}
              <span class="pp-save-badge">{{ section.settings.save_badge }}</span>
            {% endif %}
          </div>

          <form id="atcForm" method="post" action="{{ routes.cart_add_url }}">
            <input type="hidden" name="id" id="variantIdInput" value="{%- if has_product -%}{{ product.selected_or_first_available_variant.id }}{%- endif -%}">
            <input type="hidden" name="selling_plan" id="sellingPlanInput" value="">

            <!-- Flavor -->
            <div class="variant-group">
              <label class="variant-label">Flavor <span id="flavorName">{{ section.settings.default_flavor | default: 'Berry' }}</span></label>
              <div class="flavor-row" id="flavorRow">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'flavor' -%}
                    <button type="button" class="flavor-pill{% if forloop.first %} active{% endif %}" data-flavor="{{ block.settings.name }}" style="--c: {{ block.settings.color }}" {{ block.shopify_attributes }}>{{ block.settings.name }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <!-- Size -->
            <div class="variant-group">
              <label class="variant-label">{{ section.settings.size_label | default: 'Pack Size' }}</label>
              <div class="size-stack" id="sizeStack">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'size' -%}
                    <button type="button" class="size-card{% if block.settings.is_default %} active{% endif %}" data-size="{{ block.settings.size_value }}" data-price="{{ block.settings.price_fallback }}" data-was="{{ block.settings.was_fallback }}" {{ block.shopify_attributes }}>
                      {% if block.settings.badge != blank %}<span class="size-save">{{ block.settings.badge }}</span>{% endif %}
                      <div class="size-info">
                        <div class="size-name">{{ block.settings.name }}</div>
                        <div class="size-sub">{{ block.settings.sub }}</div>
                      </div>
                      <div class="size-price">${{ block.settings.price_fallback }}</div>
                    </button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <!-- Delivery -->
            <div class="variant-group">
              <label class="variant-label">{{ section.settings.delivery_label | default: 'Delivery' }}</label>
              <div class="delivery-row" id="deliveryRow">
                <button type="button" class="delivery-opt active" data-delivery="onetime">
                  <span class="d-main">{{ section.settings.onetime_main | default: 'One-Time' }}</span>
                  <span class="d-sub">{{ section.settings.onetime_sub | default: 'No commitment' }}</span>
                </button>
                <button type="button" class="delivery-opt" data-delivery="subscribe">
                  <span class="d-main">{{ section.settings.subscribe_main | default: 'Subscribe & Save 10%' }}</span>
                  <span class="d-sub">{{ section.settings.subscribe_sub | default: 'Skip or cancel anytime' }}</span>
                </button>
              </div>
            </div>

            <!-- ATC -->
            <div class="atc-row">
              <div class="qty-stepper">
                <button type="button" id="qtyMinus" aria-label="Decrease">–</button>
                <span class="qty-val" id="qtyVal">1</span>
                <button type="button" id="qtyPlus" aria-label="Increase">+</button>
              </div>
              <input type="hidden" name="quantity" id="qtyInput" value="1">
              <button class="atc-btn" type="submit" id="atcBtn">
                {{ section.settings.atc_label | default: 'Add to Cart' }}
                <span class="atc-btn-price" id="atcPrice">
                  {%- if has_product -%}{{ product.selected_or_first_available_variant.price | money }}{%- else -%}${{ section.settings.fallback_price | default: '59' }}{%- endif -%}
                </span>
              </button>
            </div>
          </form>

          <!-- Trust -->
          <div class="pp-trust">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust' -%}
                <span {{ block.shopify_attributes }}>
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="15" height="12" rx="1"/><path d="M16 8h4l3 4v4h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="19" cy="18" r="2"/></svg>
                    {%- when 'shield' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L3 7v6c0 5 4 9 9 10 5-1 9-5 9-10V7z"/></svg>
                    {%- when 'lock' -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {%- endcase -%}
                  {{ block.settings.label }}
                </span>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- Info accordion -->
          <div class="pp-info">
            {%- for block in section.blocks -%}
              {%- if block.type == 'info' -%}
                <details {% if block.settings.is_open %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.title }}</summary>
                  {% if block.settings.body_type == 'paragraph' %}
                    <p>{{ block.settings.body }}</p>
                  {% else %}
                    <ul>
                      {%- assign lines = block.settings.body | newline_to_br | split: '<br />' -%}
                      {%- for line in lines -%}
                        {%- assign trimmed = line | strip -%}
                        {%- if trimmed != blank -%}
                          <li>{{ trimmed }}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {% endif %}
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- if has_product -%}
        <script type="application/json" data-waterboy-product-data>
          {
            "id": {{ product.id | json }},
            "handle": {{ product.handle | json }},
            "options": {
              "flavorIndex": {{ flavor_index }},
              "sizeIndex": {{ size_index }}
            },
            "variants": [
              {%- for v in product.variants -%}
                {
                  "id": {{ v.id | json }},
                  "available": {{ v.available | json }},
                  "price": {{ v.price | json }},
                  "compare_at_price": {{ v.compare_at_price | json }},
                  "options": {{ v.options | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ],
            "sellingPlans": [
              {%- if product.selling_plan_groups.size > 0 -%}
                {%- for group in product.selling_plan_groups -%}
                  {%- for plan in group.selling_plans -%}
                    {
                      "id": {{ plan.id | json }},
                      "name": {{ plan.name | json }},
                      "percentage": {%- if plan.price_adjustments[0].value_type == 'percentage' -%}{{ plan.price_adjustments[0].value | json }}{%- else -%}null{%- endif -%}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                  {% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              {%- endif -%}
            ]
          }
        </script>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Waterboy Product",
  "settings": [
    { "type": "product", "id": "product", "label": "Shopify product (connects variants, price, image, Add to Cart)" },
    { "type": "paragraph", "content": "When a product is attached, price, image, variant IDs and stock are driven by Shopify. If left empty, the section renders the illustrated placeholder." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "shop" },
    { "type": "text", "id": "breadcrumb", "label": "Breadcrumb", "default": "Home / Shop / Recovery Mix" },
    { "type": "text", "id": "title", "label": "Fallback title (used when no product attached)", "default": "Waterboy Recovery Mix" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "The all-in-one recovery stick for mornings you'd rather forget. 1200mg electrolytes, 200mg L-Theanine, and a full B-complex — in one glass of water." },
    { "type": "checkbox", "id": "use_product_description", "label": "Use product description as tagline when a product is attached", "default": false },
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.9" },
    { "type": "text", "id": "rating_count", "label": "Rating link text", "default": "12,847 verified reviews" },
    { "type": "text", "id": "reviews_anchor", "label": "Reviews anchor", "default": "reviews" },
    { "type": "text", "id": "save_badge", "label": "Save badge text", "default": "Save 30%" },
    { "type": "text", "id": "fallback_price", "label": "Fallback price (no $)", "default": "59" },
    { "type": "text", "id": "fallback_was", "label": "Fallback compare price (no $)", "default": "84" },
    { "type": "text", "id": "default_flavor", "label": "Default flavor label", "default": "Berry" },
    { "type": "text", "id": "flavor_option_name", "label": "Shopify option name for flavor", "default": "Flavor" },
    { "type": "text", "id": "size_option_name", "label": "Shopify option name for size", "default": "Size" },
    { "type": "text", "id": "size_label", "label": "Size label", "default": "Pack Size" },
    { "type": "text", "id": "delivery_label", "label": "Delivery label", "default": "Delivery" },
    { "type": "text", "id": "onetime_main", "label": "One-time (main)", "default": "One-Time" },
    { "type": "text", "id": "onetime_sub", "label": "One-time (sub)", "default": "No commitment" },
    { "type": "text", "id": "subscribe_main", "label": "Subscribe (main)", "default": "Subscribe & Save 10%" },
    { "type": "text", "id": "subscribe_sub", "label": "Subscribe (sub)", "default": "Skip or cancel anytime" },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "header", "content": "Placeholder can (used only when no product image)" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "NEW" },
    { "type": "text", "id": "badge_count", "label": "Badge count", "default": "30ct" },
    { "type": "text", "id": "can_label_top", "label": "Can label top", "default": "Water" },
    { "type": "text", "id": "can_label_bottom", "label": "Can label bottom", "default": "Boy" },
    { "type": "text", "id": "can_sub_prefix", "label": "Can sub prefix", "default": "Recovery Mix" },
    { "type": "text", "id": "can_base", "label": "Can base", "default": "Electrolytes · L-Theanine · B-Complex" }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "settings": [
        { "type": "text", "id": "name", "label": "Flavor name (must match Shopify option value)", "default": "Berry" },
        { "type": "color", "id": "color", "label": "Pill color", "default": "#D64B6A" }
      ]
    },
    {
      "type": "size",
      "name": "Size / variant",
      "settings": [
        { "type": "text", "id": "name", "label": "Display name", "default": "30-Pack · Monthly" },
        { "type": "text", "id": "sub", "label": "Sub line", "default": "$1.97 per stick · save 30%" },
        { "type": "text", "id": "size_value", "label": "Shopify size option value (match exactly)", "default": "30" },
        { "type": "text", "id": "price_fallback", "label": "Fallback price (no $)", "default": "59" },
        { "type": "text", "id": "was_fallback", "label": "Fallback compare price (no $)", "default": "84" },
        { "type": "text", "id": "badge", "label": "Badge (e.g. Most Popular)" },
        { "type": "checkbox", "id": "is_default", "label": "Selected by default", "default": false }
      ]
    },
    {
      "type": "trust",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Trust badge" }
      ]
    },
    {
      "type": "info",
      "name": "Info accordion row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Ingredients" },
        {
          "type": "select", "id": "body_type", "label": "Body type",
          "options": [
            { "value": "paragraph", "label": "Paragraph" },
            { "value": "list", "label": "Bulleted list (newline-separated)" }
          ],
          "default": "paragraph"
        },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "checkbox", "id": "is_open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Waterboy Product",
      "blocks": [
        { "type": "flavor", "settings": { "name": "Berry", "color": "#D64B6A" } },
        { "type": "flavor", "settings": { "name": "Mango", "color": "#F5A623" } },
        { "type": "flavor", "settings": { "name": "Lemon-Lime", "color": "#B4D52E" } },
        { "type": "size",   "settings": { "name": "7-Pack · Starter", "sub": "$2.71 per stick · one week", "size_value": "7", "price_fallback": "19", "was_fallback": "24" } },
        { "type": "size",   "settings": { "name": "30-Pack · Monthly", "sub": "$1.97 per stick · save 30%", "size_value": "30", "price_fallback": "59", "was_fallback": "84", "badge": "Most Popular", "is_default": true } },
        { "type": "size",   "settings": { "name": "60-Pack · Bulk", "sub": "$1.82 per stick · save 35%", "size_value": "60", "price_fallback": "109", "was_fallback": "168" } },
        { "type": "trust",  "settings": { "icon": "truck",  "label": "Free shipping over $35" } },
        { "type": "trust",  "settings": { "icon": "shield", "label": "60-day guarantee" } },
        { "type": "trust",  "settings": { "icon": "lock",   "label": "Secure checkout" } },
        { "type": "info",   "settings": { "title": "Ingredients", "body_type": "paragraph", "body": "Sodium citrate, potassium chloride, magnesium malate, calcium citrate, L-Theanine (200mg), vitamin B-complex (B1, B3, B5, B6, B12, folate), vitamin C, natural fruit flavoring, stevia leaf extract, monk fruit extract, citric acid.", "is_open": true } },
        { "type": "info",   "settings": { "title": "How to Use", "body_type": "list", "body": "Tear one stick pack and pour into 12-16 oz of cold water\nStir or shake until fully dissolved (about 10 seconds)\nBest used before bed, first thing in the morning, or 30 minutes before a workout\nSafe to take once daily" } },
        { "type": "info",   "settings": { "title": "Nutrition Facts (per stick)", "body_type": "list", "body": "Calories: 15 · Total Carbs: 2g · Added Sugar: 0g\nSodium 500mg · Potassium 400mg · Magnesium 150mg\nCalcium 100mg · Chloride 500mg · Phosphorus 50mg\nL-Theanine 200mg · Full B-complex (100%+ DV)" } },
        { "type": "info",   "settings": { "title": "Shipping & Returns", "body_type": "paragraph", "body": "Orders ship within 1 business day from our Ontario warehouse. Free shipping on orders over $35 to US and Canada. 60-day money-back guarantee — if it doesn't do what we promised, email us for a refund. No need to return the box." } }
      ]
    }
  ]
}
{% endschema %}
