{{ 'waterboy.css' | asset_url | stylesheet_tag }}

<div class="waterboy">
  <section class="reviews" id="{{ section.settings.anchor | default: 'reviews' }}">
    <div class="wrap">
      <div class="section-head">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
      <div class="review-grid">
        {%- for block in section.blocks -%}
          <div class="review" {{ block.shopify_attributes }}>
            <div class="stars">{{ block.settings.stars | default: '★★★★★' }}</div>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.body }}</p>
            <div class="by">{{ block.settings.author }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Waterboy Reviews",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verified Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "12,847 Five-Star Reviews And Counting." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
        { "type": "text", "id": "title", "label": "Headline", "default": "Review headline" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Review body." },
        { "type": "text", "id": "author", "label": "Author line", "default": "Name · Verified Buyer" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Waterboy Reviews",
      "blocks": [
        { "type": "review", "settings": { "title": "Finally. Something that works.", "body": "I'm 38 and hangovers hit like a truck. Drank one of these before bed after a wedding and woke up genuinely fine. Not \"better than usual\" — actually fine. Converting all my friends.", "author": "Marcus T. · Verified Buyer" } },
        { "type": "review", "settings": { "title": "Better than Liquid I.V. by a mile", "body": "Not even close. Tastes less fake, no weird sugar crash two hours later, and the L-Theanine actually makes a noticeable difference the morning after. Subscribed.", "author": "Priya S. · Verified Buyer" } },
        { "type": "review", "settings": { "title": "My gym bag staple", "body": "Mixing it 30 min before I lift and crushing it. Zero sugar is the detail that sold me — nothing else at this electrolyte level is clean.", "author": "Jordan R. · Verified Buyer" } }
      ]
    }
  ]
}
{% endschema %}
