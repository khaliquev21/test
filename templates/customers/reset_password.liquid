{% section 'waterboy-nav' %}
{{ 'waterboy.css' | asset_url | stylesheet_tag }}

<div class="waterboy">
  <section style="padding-block: 72px; background: var(--cream);">
    <div class="wrap" style="max-width: 420px;">
      <h2 style="font-size: clamp(28px, 4vw, 40px); margin-bottom: 12px;">{{ 'customer.reset_password.title' | t | default: 'Reset your password' }}</h2>
      <p style="color: var(--ink-soft); margin-bottom: 20px;">{{ 'customer.reset_password.subtext' | t | default: 'Enter a new password below.' }}</p>

      {% form 'reset_customer_password' %}
        {{ form.errors | default_errors }}
        <div style="margin-bottom: 14px;">
          <label>{{ 'customer.reset_password.password' | t | default: 'Password' }}</label>
          <input type="password" name="customer[password]" required style="width:100%; padding: 10px 14px; border: 2px solid var(--line); border-radius: 10px; margin-top: 6px;">
        </div>
        <div style="margin-bottom: 20px;">
          <label>{{ 'customer.reset_password.password_confirm' | t | default: 'Confirm password' }}</label>
          <input type="password" name="customer[password_confirmation]" required style="width:100%; padding: 10px 14px; border: 2px solid var(--line); border-radius: 10px; margin-top: 6px;">
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">{{ 'customer.reset_password.submit' | t | default: 'Reset password' }}</button>
      {% endform %}
    </div>
  </section>
</div>

{% section 'waterboy-footer' %}
