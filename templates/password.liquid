{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'waterboy.css' | asset_url | stylesheet_tag }}
</head>
<body class="waterboy-page">
  <div class="waterboy">
    <section style="padding-block: 120px; background: var(--cream); text-align:center;">
      <div class="wrap" style="max-width: 480px;">
        <h2 style="font-size: clamp(32px, 5vw, 56px); margin-bottom: 20px;">{{ 'general.password_page.opening_soon' | t | default: 'Opening Soon' }}</h2>
        <p style="color: var(--ink-soft); margin-bottom: 28px;">{{ 'general.password_page.coming_soon' | t | default: 'Our store will be open soon.' }}</p>
        {% form 'customer', class: 'contact-form' %}
          <div style="display:flex; gap:10px;">
            <input type="email" name="contact[email]" placeholder="{{ 'general.password_page.signup_form_email_placeholder' | t | default: 'Email address' }}" required style="flex:1; padding: 12px 18px; border: 2px solid var(--line); border-radius: 999px; font-size: 15px;">
            <button type="submit" class="btn btn-primary">{{ 'general.password_page.signup_form_submit' | t | default: 'Submit' }}</button>
          </div>
          {% if form.posted_successfully? %}
            <p style="color: var(--blue-ink); margin-top: 14px;">{{ 'general.password_page.signup_form_success' | t | default: 'Thanks!' }}</p>
          {% endif %}
        {% endform %}

        <hr style="border:0; border-top: 1px solid var(--line); margin: 36px 0;">

        {% form 'storefront_password' %}
          <label style="display:block; margin-bottom: 10px; color: var(--ink);">{{ 'general.password_page.login_form_heading' | t | default: 'Enter store password' }}</label>
          <div style="display:flex; gap:10px;">
            <input type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t | default: 'Password' }}" style="flex:1; padding: 12px 18px; border: 2px solid var(--line); border-radius: 999px; font-size: 15px;">
            <button type="submit" class="btn btn-secondary">{{ 'general.password_page.login_form_submit' | t | default: 'Enter' }}</button>
          </div>
          {{ form.errors | default_errors }}
        {% endform %}
      </div>
    </section>
  </div>
</body>
</html>
